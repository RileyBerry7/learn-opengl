# Version 3 with normals and alternate winding order
mtllib brick_wall.mtl
o Side
usemtl wall

# 8 positions
v -0.5 -0.5 0.5
v -0.5 0.5 0.5
v 0.5 0.5 0.5
v 0.5 -0.5 0.5
v -0.5 -0.5 -0.5
v -0.5 0.5 -0.5
v 0.5 0.5 -0.5
v 0.5 -0.5 -0.5

# 4 UVs
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0

# 6 normals
vn 0 0 1
vn 0 0 -1
vn -1 0 0
vn 1 0 0
vn 0 1 0
vn 0 -1 0

# Front face (+Z) - Flipped order
f 1/1/1 4/4/1 3/3/1 2/2/1

# Back face (-Z) - Flipped order
f 8/4/2 5/1/2 6/2/2 7/3/2

# Left face (-X) - Flipped order
f 5/1/3 1/4/3 2/3/3 6/2/3

# Right face (+X) - Flipped order
f 4/1/4 8/4/4 7/3/4 3/2/4

# Top face (+Y) - Flipped order
f 2/1/5 3/4/5 7/3/5 6/2/5

# Bottom face (-Y) - Flipped order
f 1/1/6 5/2/6 8/3/6 4/4/6
